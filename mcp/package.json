{
  "name": "@pokemon/mcp",
  "version": "1.0.0",
  "description": "MCP server for Pokemon card price and quantity analytics",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "bun build src/server.ts --outdir dist/src --target node",
    "dev": "bun run --watch src/server.ts http",
    "start": "bun dist/src/server.js"
  },
  "dependencies": {
    "@pokemon/shared": "*",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fastmcp": "^3.15.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "jest": "^30.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
