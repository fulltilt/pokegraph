{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    // "rootDir": ".",
    "rootDirs": ["backend/src", "mcp/src", "scripts/src"],
    "baseUrl": ".", // needed for path aliases
    "paths": {
      "@backend/*": ["backend/src/*"],
      "@mcp/*": ["mcp/src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "backend/src/**/*",
    "mcp/src/**/*",
    "shared/**/*",
    "scripts/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
