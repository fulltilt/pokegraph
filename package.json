{
  "name": "pokeGraph",
  "private": true,
  "workspaces": [
    "backend/*",
    "frontend/*",
    "mcp/*",
    "shared/*"
  ],
  "scripts": {
    "build": "bun run build --workspaces",
    "build:backend": "cd backend && bun run build",
    "build:mcp": "cd mcp && bun run build",
    "start:mcp": "node dist/mcp/src/server.js",
    "start:backend": "node dist/backend/src/index.js",
    "db:generate": "prisma generate --schema=shared/prisma/schema.prisma",
    "db:push": "prisma db push --schema=shared/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=shared/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=shared/prisma/schema.prisma",
    "dev:backend": "cd backend && bun run dev",
    "dev:mcp": "cd mcp && bun run dev",
    "install:all": "bun install",
    "clean": "rm -rf dist node_modules backend/node_modules mcp/node_modules shared/node_modules"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@xenova/transformers": "^2.17.2",
    "backend": "^0.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "googleapis": "^169.0.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.2.0",
    "prisma": "^6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/form-data": "^2.5.2",
    "@types/node": "^24.3.0",
    "@types/multer": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
